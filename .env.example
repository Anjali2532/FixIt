# Create these PostgreSQL databases before running migrations.
DATABASE_URL=postgresql+psycopg://fixit_app:replace-with-local-password@127.0.0.1:5432/fixit_db
# Optional: tests otherwise use a temporary in-memory SQLite database.
# FIXIT_TEST_DATABASE_URL=postgresql+psycopg://fixit_app:replace-with-local-password@127.0.0.1:5432/fixit_test
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-secret
# Set to production only behind HTTPS. Use a shared Redis rate-limit store there.
FIXIT_ENV=development
# RATELIMIT_STORAGE_URI=redis://127.0.0.1:6379/0
